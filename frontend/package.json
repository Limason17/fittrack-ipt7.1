{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:component": "vitest run src/views/*.test.js",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:a11y": "playwright test e2e/accessibility.spec.js --project=chromium",
    "test:e2e:extra": "playwright test --project=firefox --project=webkit"
  },
  "dependencies": {
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2"
}
