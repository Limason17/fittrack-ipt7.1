{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:check": "node scripts/checkDb.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrateStatus.js",
    "db:migrate:doctor": "node scripts/migrateDoctor.js",
    "db:backup": "node scripts/dbBackup.js",
    "db:backup:daily": "node scripts/dbBackupDaily.js",
    "db:backup:status": "node scripts/dbBackupStatus.js",
    "db:restore:test": "node scripts/dbRestore.js",
    "db:backup:create": "node scripts/encryptedBackupCreate.js",
    "db:backup:verify": "node scripts/encryptedBackupVerify.js",
    "db:backup:restore": "node scripts/encryptedBackupRestore.js",
    "db:backup:drill": "node scripts/encryptedBackupDrill.js",
    "db:backup:remote:preflight": "node scripts/backupRemotePreflight.js",
    "db:backup:remote:upload": "node scripts/encryptedBackupRemoteUpload.js",
    "db:backup:remote:create-upload": "node scripts/encryptedBackupRemoteCreateUpload.js",
    "db:backup:remote:list": "node scripts/encryptedBackupRemoteList.js",
    "db:backup:remote:verify": "node scripts/encryptedBackupRemoteVerify.js",
    "db:backup:remote:download": "node scripts/encryptedBackupRemoteDownload.js",
    "db:backup:remote:drill": "node scripts/encryptedBackupRemoteDrill.js",
    "db:backup:remote:retention:plan": "node scripts/encryptedBackupRemoteRetentionPlan.js",
    "db:backup:remote:retention:apply": "node scripts/encryptedBackupRemoteRetentionApply.js",
    "db:dev:init": "node scripts/devInit.js",
    "db:test:reset": "node scripts/testDbReset.js",
    "db:test:drop": "node scripts/testDbDrop.js",
    "e2e:server": "node scripts/e2eServer.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:migrations && npm run test:syntax",
    "test:unit": "node --test test/unit/*.test.js test/startupHealth.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:migrations": "node --test --test-concurrency=1 test/migrationPlanning.test.js test/migrationDatabase.test.js test/migrationDoctor.test.js test/migrationDoctorDatabase.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/unit/*.test.js test/startupHealth.test.js test/migrationPlanning.test.js test/migrationDoctor.test.js",
    "test:syntax": "node scripts/checkSyntax.js",
    "audit:security": "npm audit --audit-level=high"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "FitTrack API",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.19.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
