NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fittrack
DB_USER=root
DB_PASSWORD=root
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

# Startup is status-only by default. Enable only for an explicitly controlled migration owner.
FITTRACK_AUTO_MIGRATE=false
# Required by db:migrate, db:dev:init, and auto-migrate; must exactly match DB_NAME.
FITTRACK_MIGRATION_EXPECTED_DATABASE=fittrack

# Generate a unique value; production rejects known placeholders and values <32 chars.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated HTTP(S) origins. Leave empty when frontend and API share an origin.
CORS_ORIGIN=http://localhost:5173

# Development/test invitation link origin. Production additionally requires an
# explicitly wired delivery provider; this setting alone never enables mail.
INVITATION_ACCEPT_BASE_URL=http://localhost:5173

# Invitation e-mail delivery (Stage 2A). Leave INVITATION_EMAIL_PROVIDER unset
# (or set to anything other than "smtp") to keep the safe default: production
# fails closed, development/test return a one-time preview link instead of
# sending mail. Setting it to "smtp" enables real delivery and requires every
# SMTP_* value below to be present and valid, or the app refuses to start.
# INVITATION_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# Use "true" for SMTPS (typically port 465) or "false" for STARTTLS
# (typically port 587). There is no unencrypted option in any environment.
# SMTP_SECURE=false
# Leave both SMTP_USER and SMTP_PASSWORD unset for a relay that does not
# require authentication, or set both together - never only one.
# SMTP_USER=replace-with-your-smtp-username
# SMTP_PASSWORD=replace-with-a-real-smtp-password
# SMTP_FROM_EMAIL=invitations@your-domain.example
# SMTP_FROM_NAME=FitTrack
# Optional; omit entirely to send no Reply-To header.
# SMTP_REPLY_TO=support@your-domain.example
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=20000

# Encrypted database backups (Stage 2B1). Required only by
# db:backup:create/verify/restore/drill, never by the running server.
# Generate a real key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_ENCRYPTION_KEY_B64 must decode to exactly 32 bytes; known
# placeholders (including the one below) and empty values are rejected.
# BACKUP_ENCRYPTION_KEY_B64=replace-with-a-base64-encoded-32-byte-key
# A short, stable label for the key above - never the key itself. Letters,
# digits, underscore and hyphen only, 1-64 characters.
# BACKUP_ENCRYPTION_KEY_ID=replace-with-a-key-id
# Absolute path outside the repository where .ftbackup files are written.
# BACKUP_OUTPUT_DIRECTORY=/absolute/path/outside/the/repository

# Optional process timeouts for the external mysqldump/mysql/docker exec
# calls the backup pipeline shells out to - safe defaults apply if left
# unset (dump 5 min, restore 10 min, generic Docker helper op 15 sec).
# Values are strictly bounded (see docs/STAGE_2B1_ENCRYPTED_BACKUP_RESTORE.md).
# BACKUP_DUMP_TIMEOUT_MS=300000
# BACKUP_RESTORE_TIMEOUT_MS=600000
# BACKUP_DOCKER_OPERATION_TIMEOUT_MS=15000

# Stage 2B1 hardening: encrypted restore requires this explicit switch -
# NODE_ENV is never sufficient authorization on its own. Leave unset in
# every environment that must never be able to run a restore.
# BACKUP_RESTORE_ENABLED=true

# The legacy, unencrypted backup path (db:backup/db:backup:daily) is
# forbidden outright in production and off by default everywhere else.
# Only set this for historical regression coverage or a local Stage-0-style
# drill - never in a real deployment, never alongside NODE_ENV=production
# (production ignores this flag entirely and always refuses).
# ALLOW_LEGACY_UNENCRYPTED_BACKUP=true

# S3-compatible off-host backup storage (Stage 2B2A). Required only by
# db:backup:remote:* commands, never by the running server. Uploads only
# already-encrypted .ftbackup files (see docs/STAGE_2B2A_S3_OFFHOST_BACKUPS.md).
# Disabled by default; every remote command refuses to run at all without this.
# Every upload is a single, atomically-conditional PutObject (IfNoneMatch:
# "*", never overwrites an existing object, even under real concurrency) -
# there is no multipart path, and no separate size variable to configure:
# the fixed 2 GiB ceiling (REMOTE_BACKUP_TOO_LARGE if exceeded) is a code
# constant, not an env var - see docs/STAGE_2B2A_S3_OFFHOST_BACKUPS.md.
# BACKUP_REMOTE_ENABLED=true
# Only "s3" is supported.
# BACKUP_REMOTE_PROVIDER=s3
# HTTPS required in production, without exception. Plain http:// is only
# accepted for an explicit loopback endpoint (e.g. local MinIO) outside
# production - see docs/STAGE_2B2A_S3_OFFHOST_BACKUPS.md.
# BACKUP_S3_ENDPOINT=https://s3.your-provider.example
# BACKUP_S3_REGION=eu-central-1
# 3-63 lowercase letters/digits/dots/hyphens; known placeholders rejected.
# BACKUP_S3_BUCKET=replace-with-your-bucket-name
# Normalized segment path only - no "..", no backslashes, no leading/duplicate
# slashes. Never put user, studio, or e-mail data in this value.
# BACKUP_S3_PREFIX=fittrack-backups
# Must be configured together, never partially; never falls back to generic
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_PROFILE - only these are read.
# BACKUP_S3_ACCESS_KEY_ID=replace-with-your-access-key-id
# BACKUP_S3_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# Optional, only needed for temporary/STS-issued credentials.
# BACKUP_S3_SESSION_TOKEN=
# Only needed for MinIO-style path-addressed buckets; must be exactly "true" or "false".
# BACKUP_S3_FORCE_PATH_STYLE=false
# Timeouts, strictly bounded - see docs/STAGE_2B2A_S3_OFFHOST_BACKUPS.md.
# BACKUP_S3_UPLOAD_TIMEOUT_MS=600000
# BACKUP_S3_DOWNLOAD_TIMEOUT_MS=600000
# BACKUP_S3_OPERATION_TIMEOUT_MS=15000
# Fail-closed bucket safety requirements checked by db:backup:remote:preflight.
# BACKUP_S3_REQUIRE_VERSIONING=false
# BACKUP_S3_REQUIRE_OBJECT_LOCK=false
# Server-side encryption in addition to (never instead of) the Stage 2B1
# client-side AES-256-GCM encryption already applied to every .ftbackup file.
# "none" | "AES256" | "aws:kms". BACKUP_S3_KMS_KEY_ID is required only for "aws:kms".
# BACKUP_S3_SERVER_SIDE_ENCRYPTION=none
# BACKUP_S3_KMS_KEY_ID=

# Remote retention deletion (Stage 2B2A) - db:backup:remote:retention:plan is
# always a dry run; :apply additionally requires all three of these to match
# exactly, plus a hard cap on how many objects may be deleted in one call.
# BACKUP_REMOTE_RETENTION_APPLY=true
# FITTRACK_REMOTE_RETENTION_BUCKET_ACK=replace-with-your-bucket-name
# FITTRACK_REMOTE_RETENTION_PREFIX_ACK=fittrack-backups
# FITTRACK_REMOTE_RETENTION_MAX_DELETE=5

# Keep 0 for direct access. Set the exact reverse-proxy hop count when deployed behind one.
TRUST_PROXY_HOPS=0

AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTRATION_RATE_LIMIT_MAX=5

# Account self-service (Stage 3B1): password change and e-mail change
# request/confirm rate limits. Same shape as the login/registration limiters
# above - independent windows, independent counters.
AUTH_PASSWORD_CHANGE_RATE_LIMIT_WINDOW_MS=3600000
AUTH_PASSWORD_CHANGE_RATE_LIMIT_MAX=5
AUTH_EMAIL_CHANGE_RATE_LIMIT_WINDOW_MS=3600000
AUTH_EMAIL_CHANGE_RATE_LIMIT_MAX=5
AUTH_EMAIL_CHANGE_CONFIRM_RATE_LIMIT_WINDOW_MS=900000
AUTH_EMAIL_CHANGE_CONFIRM_RATE_LIMIT_MAX=20

# E-mail change confirmation links reuse INVITATION_ACCEPT_BASE_URL above -
# both are links into the exact same frontend origin, just a different path
# (/invitations/:token vs. /account/email-change/:token), so there is
# deliberately no separate EMAIL_CHANGE_CONFIRM_BASE_URL to configure.
# Likewise, the e-mail change confirmation/notification messages reuse the
# same SMTP_* configuration and INVITATION_EMAIL_PROVIDER=smtp opt-in switch
# as invitations above - it is the same mail server, just a different
# message. See docs/STAGE_3B1_ACCOUNT_SELF_SERVICE.md.
