# encrypted backup container artifacts (Stage 2B1) - production targets must
# still be outside the repository; these rules only guard against an
# accidental local/relative BACKUP_OUTPUT_DIRECTORY or stray drill artifact
*.ftbackup
*.ftbackup.partial

# local MinIO off-host-storage test data (Stage 2B2A) - the compose service
# itself has no volume mount (data lives only in the container), but this
# guards against a developer adding a local bind-mount for persistence
minio-data/
.minio/

# OS files
.DS_Store
Thumbs.db

# temp files
docs/~$*
