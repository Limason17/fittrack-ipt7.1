# database backup artifacts (production targets must still be outside the repository)
*-????????T??????Z.sql
*-????????T??????Z.sql.gz
*-????????T??????Z.sql.gz.manifest.json
*.sql.partial
*.sql.gz.partial
*.sql.gz.manifest.json.partial
